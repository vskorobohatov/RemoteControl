# Copy this file to config/services.yaml and describe the services of your own machine.
# Each entry becomes one card in the dashboard and one transient systemd scope unit named
# <unit>.scope. Start and stop are idempotent and safe to call from any browser.

services:
  - id: my-service                       # [a-z0-9-], max 32 chars, must be unique
    name: My Service
    description: What this service is (shown on the card)
    # The card shows the address this service is reachable at - <origin of server.public_url>/<this id> - with a
    # copy button. There is no separate setting for it: the id IS the path, so the proxy has to route
    # location /my-service/ to this service's port, exactly as config/nginx.conf.example does.
    unit: rc-my-service                  # optional, defaults to rc-<id>; becomes rc-my-service.scope
    start:
      command: /opt/my-service/start.sh  # absolute paths are safest; ${ENV} references are expanded
      args: ["--port", "8092"]
      cwd: /opt/my-service
      env: {}                          # injected with --setenv, on top of RC_LOG_PATH
      # A service that reads its key from its own environment (Strata's server reads
      # STRATA_API_KEY) needs neither a --api-key argument nor an entry here: the values in
      # .env are already in this server's environment and a --scope inherits it. Keeping a
      # key out of argv also keeps `ps` from showing it to every user.
    # Optional: the name of the environment this service reads its key from. Naming it
    # makes the card offer a field to type that key for one start - useful when the key
    # lives with the operator rather than with the host. The typed value is handed to the
    # scope through the supervisor's own environment, never as an argument and never as
    # --setenv, which systemd-run would leave visible in `ps` for the whole run. A start
    # that leaves the field empty reuses the key this service was last started with - the
    # value is kept in the service_keys table of the database, so a restarted server reuses
    # it as well and .env is only what applies while that table holds nothing for the service.
    # The card prefills that field with the stored key - GET /api/keys hands it back to the
    # roles that may start a service - and a copy button beside the field puts it on the
    # clipboard, so an operator does not retype it on every page load. The field is greyed
    # out while the service runs: a key belongs to a start. Omit the field and a start that
    # carries a key is refused, because there is no environment for it to go into.
    api_key_env: MY_SERVICE_API_KEY
    stop:
      # SIGINT to the whole control group == one Ctrl+C press in the terminal.
      signal: SIGINT                   # SIGINT | SIGTERM | SIGHUP, default SIGINT
      grace_seconds: 90                # 1-900, default 60 -> systemd TimeoutStopSec
    health:
      url: http://127.0.0.1:8092/health
      ready_timeout_seconds: 300       # 5-3600, default 120
    # Used when the service is running but was not started by RemoteControl
    # (for example started by hand in a terminal).
    external_stop_command: pkill
    external_stop_args: ["-f", "my-service/server.py"]
    # Optional: a model selector the card shows as a dropdown and as a copyable name. Every option carries the
    # argv it adds to start.args, so a model that needs more than a name (a quantisation
    # family, a confirmation flag) travels with its option. An option's value is what a
    # start sends back and what the card's copyable zone shows, so naming it by the model
    # id the service itself reports makes that name paste into another client; the label
    # is only the human hint the dropdown reads. The default must be one of
    # the option values; pressing start without choosing reuses the last model the
    # service ran, or this default after a restart.
    # Appending is deliberate: a flag an option repeats wins over the configured one, so
    # an option may also carry a selector of the service's own kind - Strata's server
    # picks a whole engine config with ["--config", "strata-coder-iq1_m.json"], whose
    # context, drafter and memory settings then travel with it. In that layout a second
    # context size is one number in that config (--max-context is a plain engine flag in
    # its "args"), not a second option; an older Strata distribution did need one option
    # per size, because its context lived in a separate run config that a saved serving
    # profile could not override.
    model:
      default: small
      options:
        - value: small                  # [a-z0-9._-], max 64 chars, must be unique
          label: Small · 1.1 GB         # what the dropdown shows
          args: ["--family", "coder", "--model", "IQ1_M", "--yes"]
        - value: small-128k
          label: Small · 1.1 GB · 128K
          args: ["--profile", "office-128k"]
        - value: large
          label: Large · 2.7 GB
          args: ["--family", "qwen", "--model", "IQ3_XXS", "--yes"]
