# Copy to .env and fill in real values. .env is gitignored.
# RC_AUTH_TOKEN is the break-glass admin token for scripts and health probes - people sign
# in with accounts, which live in data/remotecontrol.db. Generate one with: openssl rand -hex 32
RC_AUTH_TOKEN=replace-me-with-a-long-random-token
MY_SERVICE_API_KEY=your-key-here
